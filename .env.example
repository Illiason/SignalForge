# SignalForge Configuration
# Copy this file to .env and fill in values as needed

# Force model retraining on next startup, even if saved weights exist
# Set to: 1, true, or yes
# Default: not set (loads saved model if available)
RETRAIN=

# Flask debug mode (development only; never enable in production)
# Default: 0
FLASK_DEBUG=0

# Server host and port
# Default: 0.0.0.0 and 5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
